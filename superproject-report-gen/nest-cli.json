{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      {
        "include": "reportgen/weasyprint/**/*.py",
        "outDir": "dist/reportgen/weasyprint"
      }
    ]
  }
}
